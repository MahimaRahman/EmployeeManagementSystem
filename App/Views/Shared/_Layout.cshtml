@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("Uname");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/App.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg ems-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold text-white" href="/Auth/Dashboard">
                    EMS
                </a>

                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Dashboard">Dashboard</a>
                        </li>

                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Employee/Index">Employees</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Department/Index">Departments</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Attendance/Index">Attendance</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Leave/Pending">Leaves</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Payroll/Index">Payroll</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Report/DepartmentSummary">Reports</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Attendance/EmployeeAttendance">My Attendance</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Leave/Apply">Apply Leave</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Leave/MyLeaves">My Leaves</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Payroll/MyPayroll">My Payroll</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" href="/Notification/Index">Notifications</a>
                        </li>

                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <div class="text-white small d-none d-md-block">
                            @if (!string.IsNullOrEmpty(name))
                            {
                                <span>@name</span>
                                <span class="badge bg-light text-dark ms-1">@role</span>
                            }
                        </div>

                        <a class="btn btn-sm btn-light" href="/Employee/ChangePassword">
                            Password
                        </a>

                        <a class="btn btn-sm btn-outline-light" href="/Auth/Logout">
                            Logout
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main class="ems-main">
        <div class="container py-4">

            @if (TempData["Msg"] != null)
            {
                <div class="alert @TempData["Class"] alert-dismissible fade show ems-alert" role="alert">
                    @TempData["Msg"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="ems-footer">
        <div class="container text-center">
            <span>&copy; 2026 Employee Management System</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>