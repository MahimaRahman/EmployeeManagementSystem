@model List<BLL.DTOs.AttendanceDTO>

@{
    ViewData["Title"] = "Attendance";
}

<div class="container mt-4">

    <h2>Attendance List</h2>



    <a href="/Attendance/Create" class="btn btn-primary mb-3">Mark Attendance</a>
    <a href="/Attendance/MonthlyReport" class="btn btn-info mb-3">Monthly Report</a>
    <a href="/Auth/Dashboard" class="btn btn-secondary mb-3">Back</a>

    <table class="table table-bordered table-striped">
        <tr>
            <th>Id</th>
            <th>Employee</th>
            <th>Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AttendanceId</td>
                <td>@item.EmployeeName</td>
                <td>@item.AttendanceDate</td>
                <td>@item.Status</td>
                <td>
                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.AttendanceId" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this attendance?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>

</div>