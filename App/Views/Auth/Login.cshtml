
@model BLL.DTOs.LoginDTO



@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}



@{
    ViewData["Title"] = "Login";
}



<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-5">

            @if (TempData["Msg"] != null)
            {
                <div class="alert @TempData["Class"]">
                    @TempData["Msg"]
                </div>
            }

            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h3 class="text-center mb-1 text-primary">Employee Management System</h3>
                    <p class="text-center text-secondary mb-4">Login to continue</p>

                    <form method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" placeholder="Enter email" name="Email" class="form-control" />
                            <span class="text-danger">@Html.ValidationMessage("Email")</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" placeholder="Enter password" name="Password" class="form-control" />
                            <span class="text-danger">@Html.ValidationMessage("Password")</span>
                        </div>

                        <input type="submit" value="Login" class="btn btn-primary w-100" />

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
