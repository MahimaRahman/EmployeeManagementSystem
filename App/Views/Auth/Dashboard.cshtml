@{
    ViewData["Title"] = "Dashboard";

    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("Uname");
}

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

            <div>
                <h2 class="mb-1">Employee Management System</h2>
                <p class="text-muted mb-3">Dashboard Overview</p>

                <h5 class="mb-1">Welcome, @name</h5>
                <span class="badge bg-primary">@role</span>
            </div>



            <a class="btn btn-light position-relative border" href="/Notification/Index" title="Notifications">
                🔔

                @if (ViewBag.UnreadNotification != null && ViewBag.UnreadNotification > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @ViewBag.UnreadNotification
                    </span>
                }
            </a>




        </div>
    </div>
</div>

@if (role == "Admin")
{
    <h4 class="mb-3">Admin Menu</h4>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Employees</h5>
                    <p class="text-muted">Manage employee information</p>
                    <a class="btn btn-primary" href="/Employee/Index">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Departments</h5>
                    <p class="text-muted">Manage department records</p>
                    <a class="btn btn-primary" href="/Department/Index">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Attendance</h5>
                    <p class="text-muted">Track daily attendance</p>
                    <a class="btn btn-primary" href="/Attendance/Index">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Leave Requests</h5>
                    <p class="text-muted">Approve or reject leave</p>
                    <a class="btn btn-primary" href="/Leave/Pending">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Payroll</h5>
                    <p class="text-muted">Generate employee payroll</p>
                    <a class="btn btn-primary" href="/Payroll/Index">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Department Report</h5>
                    <p class="text-muted">View salary and employee report</p>
                    <a class="btn btn-primary" href="/Report/DepartmentSummary">Open</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="mb-3">Employee Menu</h4>

    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>My Attendance</h5>
                    <p class="text-muted">View your attendance records</p>
                    <a class="btn btn-primary" href="/Attendance/EmployeeAttendance">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>Apply Leave</h5>
                    <p class="text-muted">Submit a leave request</p>
                    <a class="btn btn-primary" href="/Leave/Apply">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>My Leaves</h5>
                    <p class="text-muted">Check leave status</p>
                    <a class="btn btn-primary" href="/Leave/MyLeaves">Open</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5>My Payroll</h5>
                    <p class="text-muted">View salary records</p>
                    <a class="btn btn-primary" href="/Payroll/MyPayroll">Open</a>
                </div>
            </div>
        </div>
    </div>
}