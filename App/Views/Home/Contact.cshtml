@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .contact-box {
        width: 60%;
        margin: 70px auto;
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

        .contact-box h1 {
            color: #1f2937;
            margin-bottom: 20px;
        }

        .contact-box p {
            color: #4b5563;
            font-size: 17px;
            line-height: 1.7;
        }

    .info {
        margin-top: 25px;
    }

        .info p {
            margin: 10px 0;
        }
</style>

<div class="contact-box">
    <h1>Contact Us</h1>

    <p>
        For any information about this Employee Management System,
        please contact the system administrator.
    </p>

    <div class="info">
        <p><b>Email:</b> admin@ems.com</p>
        <p><b>Phone:</b> 01234567890</p>
        <p><b>Address:</b> Dhaka, Bangladesh</p>
    </div>
</div>