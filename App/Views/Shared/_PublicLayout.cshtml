</head>
<body>

    <div class="navbar">
        <h2>Employee Management System</h2>

        <div>
            <a href="/Home/Index">Home</a>
            <a href="/Home/About">About</a>
            <a href="/Home/Contact">Contact</a>
            <a href="/Auth/Login">Login</a>
        </div>
    </div>

    <div class="content">
        @RenderBody()
    </div>

    <div class="footer">
        <p>&copy; 2026 Employee Management System.</p>
    </div>

