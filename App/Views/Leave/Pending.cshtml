@model List<BLL.DTOs.LeaveRequestDTO>

@{
    ViewData["Title"] = "Pending Leaves";
}

<div class="container mt-4">

    <h2>Pending Leave Requests</h2>

    

    <a href="/Leave/Index" class="btn btn-info mb-3">All Leaves</a>
    <a href="/Auth/Dashboard" class="btn btn-secondary mb-3">Back</a>

    <table class="table table-bordered table-striped">
        <tr>
            <th>Employee</th>
            <th>Leave Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Action</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeName</td>
                <td>@item.LeaveType</td>
                <td>@item.StartDate</td>
                <td>@item.EndDate</td>
                <td>@item.Reason</td>
                <td>@item.Status</td>
                <td>
                    <form asp-action="Review" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.LeaveRequestId" />
                        <input type="hidden" name="status" value="Approved" />
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                    </form>

                    <form asp-action="Review" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.LeaveRequestId" />
                        <input type="hidden" name="status" value="Rejected" />
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </table>

</div>