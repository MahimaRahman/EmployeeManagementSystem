@model BLL.DTOs.EmployeeDTO

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">

    <h2>Employee Details</h2>

    <table class="table table-bordered">
        <tr>
            <th>Employee Id</th>
            <td>@Model.EmployeeId</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>@Model.FirstName @Model.LastName</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>
        <tr>
            <th>Phone</th>
            <td>@Model.Phone</td>
        </tr>
        <tr>
            <th>Department</th>
            <td>@Model.DepartmentName</td>
        </tr>
        <tr>
            <th>Join Date</th>
            <td>@Model.JoinDate</td>
        </tr>
        <tr>
            <th>Basic Salary</th>
            <td>@Model.BasicSalary</td>
        </tr>
        <tr>
            <th>Role</th>
            <td>@Model.Role</td>
        </tr>
        <tr>
            <th>Is Active</th>
            <td>@Model.IsActive</td>
        </tr>
    </table>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <a href="/Employee/Update/@Model.EmployeeId" class="btn btn-info">Edit</a>
    }

    <a href="/Employee/Index" class="btn btn-secondary">Back</a>

</div>