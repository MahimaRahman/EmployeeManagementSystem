@model BLL.DTOs.AttendanceDTO

@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="container mt-4">

    <div class="col-md-6">

        <h2>Mark Attendance</h2>

        @if (TempData["Msg"] != null)
        {
            <div class="alert @TempData["Class"]">
                @TempData["Msg"]
            </div>
        }

        <form method="post">

            <div class="mb-3">
                <label class="form-label">Employee</label>
                <select name="EmployeeId" class="form-control">
                    <option value="">--Select Employee--</option>
                    @foreach (var e in ViewBag.Employees)
                    {
                        <option value="@e.EmployeeId">@e.FirstName @e.LastName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Attendance Date</label>
                <input type="date" name="AttendanceDate" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select name="Status" class="form-control">
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    <option value="Leave">Leave</option>
                </select>
            </div>

            <input type="submit" value="Save" class="btn btn-primary" />
            <a href="/Attendance/Index" class="btn btn-secondary">Back</a>

        </form>

    </div>

</div>