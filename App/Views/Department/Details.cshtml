@model BLL.DTOs.DepartmentDTO

@{
    ViewData["Title"] = "Department Details";
}

<div class="container mt-4">

    <h2>Department Details</h2>

    <table class="table table-bordered">
        <tr>
            <th>Department Id</th>
            <td>@Model.DepartmentId</td>
        </tr>

        <tr>
            <th>Department Name</th>
            <td>@Model.DepartmentName</td>
        </tr>

        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>
    </table>

    <a href="/Department/Update/@Model.DepartmentId" class="btn btn-warning">Edit</a>
    <a href="/Department/Index" class="btn btn-secondary">Back</a>

</div>