@model List<BLL.DTOs.DepartmentDTO>

@{
    ViewData["Title"] = "Departments";
}

<div class="container mt-4">

    <h2>Departments</h2>



    <a href="/Department/Create" class="btn btn-primary mb-3">Create New</a>
    <a href="/Auth/Dashboard" class="btn btn-secondary mb-3">Back</a>

    <table class="table table-bordered table-striped">
        <tr>
            <th>Department Id</th>
            <th>Department Name</th>
            <th>Description</th>
            <th>Action</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DepartmentId</td>
                <td>@item.DepartmentName</td>
                <td>@item.Description</td>
                <td>
                    <a href="/Department/Details/@item.DepartmentId" class="btn btn-info btn-sm">Details</a>

                    <a href="/Department/Update/@item.DepartmentId" class="btn btn-warning btn-sm">Edit</a>
                    

                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.DepartmentId" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>

</div>