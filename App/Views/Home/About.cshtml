@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .about-box {
        width: 70%;
        margin: 70px auto;
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

        .about-box h1 {
            color: #1f2937;
            margin-bottom: 20px;
        }

        .about-box p {
            color: #4b5563;
            font-size: 17px;
            line-height: 1.7;
        }
</style>

<div class="about-box">
    <h1>About Employee Management System</h1>

    <p>
        Employee Management System is a simple web based application.
