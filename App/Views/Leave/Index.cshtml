@model List<BLL.DTOs.LeaveRequestDTO>

@{
    ViewData["Title"] = "All Leaves";
}

<div class="container mt-4">

    <h2>All Leave Requests</h2>

    <a href="/Leave/Pending" class="btn btn-primary mb-3">Pending Leaves</a>
    <a href="/Auth/Dashboard" class="btn btn-secondary mb-3">Back</a>

    <table class="table table-bordered table-striped">
        <tr>
            <th>Employee</th>
            <th>Leave Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Reviewed By</th>
            <th>Reviewed At</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeName</td>
                <td>@item.LeaveType</td>
                <td>@item.StartDate</td>
                <td>@item.EndDate</td>
                <td>@item.Reason</td>
                <td>@item.Status</td>
                <td>@item.ReviewedBy</td>
                <td>@item.ReviewedAt</td>
            </tr>
        }
    </table>

</div>