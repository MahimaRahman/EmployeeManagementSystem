<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <title>Employee Management System</title>

    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f4f7fb;
            }

            .navbar {
                background: #1f2937;
                padding: 15px 60px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .navbar h2 {
                    color: white;
                    margin: 0;
                }

                .navbar a {
                    color: white;
                    text-decoration: none;
                    margin-left: 20px;
                    font-size: 15px;
                }

                    .navbar a:hover {
                        color: #93c5fd;
                    }

            .content {
                min-height: 500px;
            }

            .footer {
                background: #111827;
                color: white;
                text-align: center;
                padding: 18px;
                margin-top: 40px;
            }
