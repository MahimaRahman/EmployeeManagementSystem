@model List<BLL.DTOs.PayrollDTO>

@{
    ViewData["Title"] = "My Payroll";
}

<div class="container mt-4">

    <h2>My Payroll</h2>

    <a href="/Auth/Dashboard" class="btn btn-secondary mb-3">Back</a>

    <table class="table table-bordered table-striped">
        <tr>
            <th>Month</th>
            <th>Year</th>
            <th>Working Days</th>
            <th>Present Days</th>
            <th>Gross Salary</th>
            <th>Net Salary</th>
            <th>Generated At</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Month</td>
                <td>@item.Year</td>
                <td>@item.WorkingDays</td>
                <td>@item.PresentDays</td>
                <td>@item.GrossSalary</td>
                <td>@item.NetSalary</td>
                <td>@item.GeneratedAt</td>
            </tr>
        }
    </table>

</div>